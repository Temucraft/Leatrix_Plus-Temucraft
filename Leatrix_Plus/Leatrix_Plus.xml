	<ScrollFrame name="LeaPlusConfigurationPanelScrollFrameTemplate" inherits="ScrollFrameTemplate" virtual="true">
	</ScrollFrame>
	<!-- Temucraft: the newer slider is drawn with atlas textures, which the 3.3.5 client doesn't have (the bar and
	     the knob were invisible). This is the 3.3.5 options slider look. -->
	<Slider name="LeaPlusConfigurationPanelSliderTemplate" orientation="HORIZONTAL" enableMouse="true" virtual="true">
		<Size><AbsDimension x="100" y="17"/></Size>
		<HitRectInsets>
			<AbsInset left="0" right="0" top="-10" bottom="-10"/>
		</HitRectInsets>
		<Backdrop bgFile="Interface\Buttons\UI-SliderBar-Background" edgeFile="Interface\Buttons\UI-SliderBar-Border" tile="true">
			<EdgeSize><AbsValue val="8"/></EdgeSize>
			<TileSize><AbsValue val="8"/></TileSize>
			<BackgroundInsets><AbsInset left="3" right="3" top="6" bottom="6"/></BackgroundInsets>
		</Backdrop>
		<ThumbTexture file="Interface\Buttons\UI-SliderBar-Button-Horizontal">
			<Size><AbsDimension x="32" y="32"/></Size>
		</ThumbTexture>
	</Slider>
